---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  eager?: boolean;
}
const { image, alt, caption, eager = false } = Astro.props;
---
<figure class="case-figure">
  <!-- The original opens separately when screenshot text is too small to read. -->
  <a href={image.src} target="_blank" rel="noopener" aria-label={`Open full-size image: ${alt}`}>
    <Image src={image} alt={alt} widths={[400, 850, 1440]} sizes="(max-width: 906px) calc(100vw - 56px), 850px" format="webp" loading={eager ? 'eager' : 'lazy'} />
  </a>
  <figcaption>{caption} <a href={image.src} target="_blank" rel="noopener">View full size</a></figcaption>
</figure>
