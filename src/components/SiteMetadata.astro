---
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
// Only emit absolute public URLs when a production domain is configured.
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site) : undefined;
const shareImage = Astro.site ? new URL('/social-preview.png', Astro.site) : undefined;
---
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="description" content={description} />
<meta name="theme-color" content="#F6EEDC" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Michael Muñoz · Learning Design & Strategy" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{shareImage && <>
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Michael Muñoz — Learning design and strategy. Experience. Programs. Architecture." />
</>}
<meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{shareImage && <meta name="twitter:image" content={shareImage} />}
