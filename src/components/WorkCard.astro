---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title: string; category: string; summary: string; href: string; image?: ImageMetadata; imageAlt?: string; }
const { title, category, summary, href, image, imageAlt = '' } = Astro.props;
const titleId = `work-${href.split('/').pop()}`;
---
<article class="port-card">
  <div class="tape" aria-hidden="true"></div>
  <a class="work-card-link" href={href} aria-labelledby={titleId}>
    {image && <Image class="card-image" src={image} alt={imageAlt} widths={[320, 640]} sizes="(max-width: 900px) min(360px, calc(100vw - 100px)), 290px" format="webp" loading="lazy" />}
    <span class="pill">{category}</span>
    <h3 id={titleId}>{title}</h3>
    <p>{summary}</p>
    <span class="card-action">View case study →</span>
  </a>
</article>
<style>
  .work-card-link { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .work-card-link .pill { align-self: flex-start; }
  .work-card-link h3, .card-action { text-decoration: underline; text-underline-offset: 3px; }
  .card-action { margin-top: auto; }
  .card-image { width: 100%; height: auto; aspect-ratio: 16 / 11; object-fit: contain; background: var(--cream-2); border: 1px solid var(--paper-edge); border-radius: 4px; margin-bottom: 18px; }
</style>
