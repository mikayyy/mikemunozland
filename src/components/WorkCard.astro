---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title: string; category: string; summary: string; href: string; image?: ImageMetadata; imageAlt?: string; }
const { title, category, summary, href, image, imageAlt = '' } = Astro.props;
---
<div class="port-card">
  <div class="tape"></div>
  {image && <a class="card-image-link" href={href} aria-label={`View ${title} case study`}><Image class="card-image" src={image} alt={imageAlt} widths={[320, 640]} sizes="(max-width: 900px) calc(100vw - 100px), 290px" format="webp" loading="lazy" /></a>}
  <span class="pill">{category}</span>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <a href={href}>View case study →</a>
</div>

<style>
  .card-image-link { display: block; margin-bottom: 18px; }
  .card-image { width: 100%; height: auto; border: 1px solid var(--paper-edge); border-radius: 4px; }
</style>
