---
interface Props { title: string; category: string; summary: string; href: string; }
const { title, category, summary, href } = Astro.props;
---
<div class="port-card">
  <div class="tape"></div>
  <span class="pill">{category}</span>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <a href={href}>View case study →</a>
</div>
