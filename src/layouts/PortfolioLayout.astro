---
import SiteMetadata from '../components/SiteMetadata.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/portfolio.css';
interface Props { title?: string; description?: string; home?: boolean; noindex?: boolean; }
const { title = 'Michael Muñoz — Learning Designer & Strategist', description = 'Michael Muñoz designs learning experiences, programs, and capability systems. Explore interactive work and case studies in learning design and strategy.', home = false, noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <SiteMetadata title={title} description={description} noindex={noindex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <SiteHeader home={home} />
    <slot />
    <SiteFooter />
  </body>
</html>
